# Copy to backend/.env for local runs (never commit .env). Placeholders only: no real secrets belong in this file.
# The server reads process.env; load the file with your process manager or `node --env-file=.env`.

PORT=8787
# devnet or localnet. Mainnet is deliberately not accepted until the project owner approves it.
NETWORK=devnet
RPC_URL=https://api.devnet.solana.com
# Leave empty to use the program id from the IDL (BMTXJRZ4QxzCg4UCHKo6qGGiGXKW26ARPAtPaXA8k7EL on devnet).
PROGRAM_ID=

# At least 32 random characters, e.g. `openssl rand -hex 32`. Signs the short-lived API tokens.
JWT_SECRET=
# Domain shown in the wallet sign-in message and checked on verify. Must equal what the app passes to the wallet.
AUTH_DOMAIN=vowed.app

# Throwaway devnet keys only (JSON array of 64 bytes or base58). Generate with `solana-keygen new`.
# The oracle can ONLY call record_checkin; keep it separate from the admin / upgrade authority key.
ORACLE_SECRET_KEY=
# Pays fees for permissionless settlement and sweeps. Holds no authority and needs only a little SOL.
CRANK_SECRET_KEY=

DATABASE_PATH=./dev.sqlite
# true starts the indexer, oracle retry, settlement crank and daily jobs inside the server process.
RUN_JOBS=false

# true rejects devices that offer no hardware key attestation (use true outside development).
REQUIRE_ATTESTATION=false

# Optional: Firebase service-account JSON (one line). Without it push notifications are only logged in memory.
FCM_SERVICE_ACCOUNT_JSON=

# Optional test-token faucet (devnet/localnet only; leave empty to disable). TEST tokens only, no real value.
# The authority key must be the mint authority of both test mints and holds a little SOL for fees and token-account rent.
# Keep it out of git and out of the app. Amounts are base units (6 decimals): 20000000 = 20 tokens.
FAUCET_AUTHORITY_SECRET_KEY=
FAUCET_USDC_MINT=
FAUCET_SKR_MINT=
FAUCET_USDC_AMOUNT=20000000
FAUCET_SKR_AMOUNT=20000000
# at most this many claims across all wallets per UTC day
FAUCET_GLOBAL_DAILY_CLAIMS=200
# one claim per wallet per this many seconds (86400 = 24 hours)
FAUCET_COOLDOWN_SECS=86400

# Goal parser (plain-language goals). Leave GEMINI_API_KEY empty to use only the built-in templates.
# The key stays on the server (never in the app) and only the typed goal text is sent to the model. Free-tier terms: Google may use
# submitted content to improve its products and humans may read it, so the app tells people not to type personal details.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# template_first (default): confident template matches are answered without the model; llm_first: always ask the model first; template_only: never.
GOALS_PARSER_MODE=template_first
GOALS_LLM_TIMEOUT_MS=15000
# free-tier protection: model calls per wallet per hour, and across everyone per UTC day
GOALS_LLM_PER_WALLET_HOUR=12
GOALS_LLM_DAILY_CAP=300
