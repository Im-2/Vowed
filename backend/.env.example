# Copy to backend/.env for local runs (never commit .env). Placeholders only: no real secrets belong in this file.
# The server reads process.env; load the file with your process manager or `node --env-file=.env`.

PORT=8787
# devnet or localnet. Mainnet is deliberately not accepted until the project owner approves it.
NETWORK=devnet
RPC_URL=https://api.devnet.solana.com
# Leave empty to use the program id from the IDL (BMTXJRZ4QxzCg4UCHKo6qGGiGXKW26ARPAtPaXA8k7EL on devnet).
PROGRAM_ID=

# At least 32 random characters, e.g. `openssl rand -hex 32`. Signs the short-lived API tokens.
JWT_SECRET=
# Domain shown in the wallet sign-in message and checked on verify. Must equal what the app passes to the wallet.
AUTH_DOMAIN=vowed.app

# Throwaway devnet keys only (JSON array of 64 bytes or base58). Generate with `solana-keygen new`.
# The oracle can ONLY call record_checkin; keep it separate from the admin / upgrade authority key.
ORACLE_SECRET_KEY=
# Pays fees for permissionless settlement and sweeps. Holds no authority and needs only a little SOL.
CRANK_SECRET_KEY=

DATABASE_PATH=./dev.sqlite
# true starts the indexer, oracle retry, settlement crank and daily jobs inside the server process.
RUN_JOBS=false

# true rejects devices that offer no hardware key attestation (use true outside development).
REQUIRE_ATTESTATION=false

# Optional: Firebase service-account JSON (one line). Without it push notifications are only logged in memory.
FCM_SERVICE_ACCOUNT_JSON=
