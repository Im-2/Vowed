<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- the window background is the app's lavender, so there is no white flash before the first screen draws -->
    <style name="Theme.Vowed" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/vowed_lavender</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
